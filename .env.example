# The gateway's public Render URL. This is safe to expose to the browser
# (it's the one thing the frontend is allowed to talk to), so NEXT_PUBLIC_
# is correct here — unlike ADMIN_TOKEN on the admin panel, which must
# never be a NEXT_PUBLIC_/build-time variable.
NEXT_PUBLIC_API_URL="https://kplc-chatbot-gateway.onrender.com"

# For reference, the gateway (above) in turn talks to:
#   SESSION_BACKEND_URL = https://kplc-kaggle-notebook-instance.onrender.com
#   DATASET_BACKEND_URL = https://dataset-trigger-backend.onrender.com
# Those two are set on the gateway's own Render service, not here — this
# frontend never talks to them directly.

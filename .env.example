# The gateway's public Render URL. This is the one service the frontend
# actually calls for /session/start, /session/status and /chat. Safe to
# expose to the browser, so NEXT_PUBLIC_ is correct here — unlike
# ADMIN_TOKEN on the admin panel, which must never be a NEXT_PUBLIC_/
# build-time variable.
NEXT_PUBLIC_API_URL="https://kplc-chatbot-gateway.onrender.com"

# The session backend and dataset backend are also public Render URLs
# (the gateway talks to both of these itself for the real work — see
# the deployment guide, Section 6). The frontend does NOT call their
# real endpoints or hold any secret for them; it only pings their public,
# no-auth GET /health so all three free-tier services wake up in
# parallel instead of one after another. Leave either blank to skip
# warming it.
NEXT_PUBLIC_SESSION_BACKEND_URL="https://kplc-kaggle-notebook-instance.onrender.com"
NEXT_PUBLIC_DATASET_BACKEND_URL="https://dataset-trigger-backend.onrender.com"
